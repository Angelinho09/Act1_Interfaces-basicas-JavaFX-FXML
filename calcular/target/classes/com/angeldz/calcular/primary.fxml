<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="452.0" prefWidth="339.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.angeldz.calcular.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <AnchorPane prefHeight="420.0" prefWidth="299.0">
         <children>
            <Label layoutY="14.0" text="Tabla del:" />
            <TextField fx:id="txtNumero" blendMode="GREEN" cache="true" cacheHint="SCALE" depthTest="DISABLE" layoutX="14.0" layoutY="47.0" prefHeight="17.0" prefWidth="110.0" promptText="ingresa el numero" />
            <Button layoutX="212.0" layoutY="39.0" mnemonicParsing="false" onAction="#calcular" text="Calcular" />
            <Button layoutX="214.0" layoutY="64.0" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
            <TextArea fx:id="txtTabla" blendMode="GREEN" layoutX="14.0" layoutY="106.0" prefHeight="244.0" prefWidth="240.0" />
         </children>
      </AnchorPane>
   </children>
</VBox>
