<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="346.0" prefWidth="374.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.angeldz.edad.PrimaryController">
   <children>
      <Label prefHeight="20.0" prefWidth="152.0" text="FECHA DE NACIMIENTO " />
      <TextField id="txtFecha" fx:id="txtFecha" promptText="DD/MM/AAAA" />
      <Label id="lblResultado" fx:id="lblResultado" prefHeight="46.0" prefWidth="230.0" />
      <Label />
      <Button mnemonicParsing="false" onAction="#calcularEdad" prefHeight="35.0" prefWidth="80.0" text="CALCULAR" />
      <Button mnemonicParsing="true" onAction="#limpiarValor" text="LIMPIAR" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
