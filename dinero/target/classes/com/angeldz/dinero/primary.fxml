<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fillWidth="false" nodeOrientation="LEFT_TO_RIGHT" prefHeight="417.0" prefWidth="521.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.angeldz.dinero.PrimaryController">
   <children>
      <Label text="Dinero" />
      <TextField fx:id="txtDinero" prefHeight="26.0" prefWidth="257.0" promptText="ingresa unicamente numeros enteros" />
      <HBox prefHeight="43.0" prefWidth="228.0">
         <children>
            <Button mnemonicParsing="false" onAction="#borrarCampos" prefHeight="43.0" prefWidth="115.0" text="borrar" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#calcularDesglose" prefHeight="43.0" prefWidth="114.0" text="desglose" textAlignment="CENTER" textOverrun="LEADING_ELLIPSIS" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
      <HBox prefHeight="188.0" prefWidth="467.0">
         <children>
            <TextArea fx:id="txtEtiquetas" prefHeight="248.0" prefWidth="233.0" />
            <TextArea fx:id="txtCantidades" prefHeight="248.0" prefWidth="244.0" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
